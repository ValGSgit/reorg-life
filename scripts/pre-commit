#!/bin/sh
# Blocks commits containing secrets or personal data. Install: sh scripts/install-hooks.sh
if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact -v || exit 1
else
  echo "warning: gitleaks not installed (https://github.com/gitleaks/gitleaks); skipping secret scan"
fi
if git diff --cached --name-only | grep -Ei '\.(db|sqlite)$|(^|/)exports/|private-data/'; then
  echo "error: personal data files staged. Aborting."; exit 1
fi
