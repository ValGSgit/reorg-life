{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Jest globals (describe/it/expect) and Node globals (Buffer, node:sqlite)
    // are used by the test suites; without this, `tsc --noEmit` cannot see them.
    "types": ["jest", "node"]
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  "exclude": ["node_modules", "dist", "coverage", "playwright-report"]
}
